[Unit]
Description=Shad Scanner WiFi Setup Service
After=network.target NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/shad/shad-setup
ExecStart=/usr/bin/python3 /home/shad/shad-setup/wifi_setup.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security settings
NoNewPrivileges=false
PrivateTmp=yes

[Install]
WantedBy=multi-user.target